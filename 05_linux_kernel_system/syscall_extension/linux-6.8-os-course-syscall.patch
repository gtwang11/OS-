diff --git a/include/linux/syscalls.h b/include/linux/syscalls.h
--- a/include/linux/syscalls.h
+++ b/include/linux/syscalls.h
@@ -1290,4 +1290,8 @@ int __sys_setsockopt(int fd, int level, int optname, char __user *optval,
 		int optlen);
 #endif
 
+asmlinkage long sys_os_course_info(int __user *user_pid,
+				   char __user *user_comm,
+				   size_t user_len);
+
 #endif
